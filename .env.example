# PostHog (the Casa-Libre project's client key, phc_…). Read at request time by /api/analytics-config/.
POSTHOG_KEY=
# optional, default https://us.i.posthog.com
POSTHOG_HOST=

# Lead form: the funnel_leads table of each country's Casa-Libre database
AIROBASE_URL_PY=
AIROBASE_SECRET_KEY_PY=
# optional: also POST every lead to this URL
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
